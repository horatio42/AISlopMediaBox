# -----------------------------------------------------------------------------
# AISlopMediaBox — every knob, one file. Copy to `.env` for docker compose.
# Everything persistent still lives in /data; env vars are only boot config.
# -----------------------------------------------------------------------------

# Host port published by docker compose. The container always listens on 3100.
# Change this if port 3100 is already taken, e.g. SLOP_PORT=8080.
SLOP_PORT=3100

# The paths below are fixed by the Docker image (/data volume) so backups stay
# predictable. They matter when running from source, not for compose.
# PORT=3100
# HOST=0.0.0.0
# DATA_DIR=/data
# MEDIA_DIR=/data/media

# First admin account. CHANGE THESE. Defaults are a running joke, not security.
ADMIN_USER=admin
ADMIN_PASSWORD=slop123

# Generate an original demo library on first boot (needs ffmpeg; no network).
SEED_DEMO=1
DEMO_MODE=1

# Reverse proxy? Set SECURE_COOKIES=1 for HTTPS-only session cookies.
SECURE_COOKIES=0
TRUST_PROXY=0

# Sessions last this long.
SESSION_DAYS=30

# Playback / transcoding. Direct play is preferred; remux (copy video) is preferred over a
# full re-encode when only the container is wrong.
MAX_TRANSCODE_HEIGHT=1080
TRANSCODE_PRESET=veryfast
TRANSCODE_CONCURRENCY=2
HLS_SEGMENT_SECONDS=4

# Hardware acceleration. auto probes ffmpeg + device nodes and smoke-encodes each candidate.
# Modes: auto | none | nvenc | qsv | vaapi | amf | rkmpp | v4l2m2m | vulkan | videotoolbox
TRANSCODE_HWACCEL=auto
# Optional VAAPI device override, e.g. /dev/dri/renderD129 on a mixed iGPU/dGPU host.
# TRANSCODE_HWACCEL_DEVICE=/dev/dri/renderD128
# Pause ffmpeg once it is this many seconds ahead of the client. 0 disables throttling.
TRANSCODE_THROTTLE_SECONDS=120

# Scanning
SCAN_CONCURRENCY=4

# Optional host folder exposed read-only at /media for libraries and ingestion.
MEDIA_HOST_DIR=./media

# Optional online metadata (OFF by default — the box makes zero outbound calls
# unless you explicitly set a key or toggle a keyless provider in Admin → Settings).
# Local NFO + filename matching always works.
# TMDB_API_KEY=
# TVDB_API_KEY=
# OMDB_API_KEY=

# Optional explicit binaries (bundled in Docker).
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Logging verbosity: debug | info | warn | error
LOG_LEVEL=info

# Timezone for log/UI dates.
TZ=Etc/UTC

# Host user id for /data permissions when using bind mounts.
PUID=1000
PGID=1000
