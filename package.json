{
  "name": "aislopmediabox",
  "version": "1.0.0",
  "private": true,
  "description": "AISlopMediaBox — a fully self-hosted media library, streaming server, and admin panel. 100% AI slop, 0% shame.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "demo": "node scripts/demo-content.mjs",
    "demo:seed": "node scripts/seed.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "express": "^5.1.0",
    "hls.js": "^1.7.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
